# USAspending Data Warehouse — environment configuration template.
# Copy to `.env` and adjust. NEVER commit a real `.env` (it is git-ignored).
#
# Milestone 1 uses ONLY the public USAspending.gov API, which requires no
# credentials. No secrets are needed yet. Cloud/warehouse variables are listed
# here for forward-compatibility but are unused until later milestones.

# ---- USAspending API ----
USASPENDING_API_BASE_URL=https://api.usaspending.gov
USASPENDING_HTTP_TIMEOUT_SECONDS=60
USASPENDING_MAX_RETRIES=5
USASPENDING_BACKOFF_BASE_SECONDS=1.0
USASPENDING_BACKOFF_MAX_SECONDS=30.0
# Max seconds to wait for an async bulk-download job to finish before giving up.
USASPENDING_DOWNLOAD_POLL_TIMEOUT_SECONDS=1800
USASPENDING_DOWNLOAD_POLL_INTERVAL_SECONDS=5.0

# ---- Local data lake layout ----
FSDW_DATA_DIR=data

# ---- Logging ----
# One of: DEBUG, INFO, WARNING, ERROR
FSDW_LOG_LEVEL=INFO
# "json" for structured logs, "text" for human-readable console logs.
FSDW_LOG_FORMAT=json

# ---- Safe-extraction limits (zip-bomb / path-traversal guardrails) ----
FSDW_MAX_EXTRACT_BYTES=2147483648      # 2 GiB uncompressed cap
FSDW_MAX_EXTRACT_FILES=256

# ---- Milestone 2: historical batch processing / partitioning ----
FSDW_BATCH_SIZE=50000                   # rows per streaming CSV batch (bounds memory)
FSDW_PARQUET_COMPRESSION=zstd           # zstd | snappy | gzip | none
FSDW_PARQUET_ROW_GROUP_SIZE=100000      # Parquet row-group size (rows)
FSDW_TARGET_PARTITION_FILE_ROWS=1000000 # roll to a new part-file above this many rows

# ---- Reserved for later milestones (UNUSED in Milestone 1) ----
# AWS_S3_BUCKET=
# SNOWFLAKE_ACCOUNT=
# SNOWFLAKE_USER=
