# ---- Secrets / environment ----
.env
.env.*
!.env.example
*.pem
*.key
credentials.json
secrets/

# ---- Ingested data (raw + derived; never committed) ----
# All data-lake contents are git-ignored (raw, staged, published, and all
# generated artifacts). Nothing under data/ is ever committed.
data/
data/raw/
data/parquet/
data/quarantine/
data/manifests/
data/staging/
data/schemas/
data/profiles/
data/benchmarks/
data/checkpoints/

# ---- Generated analytics reports (keep the directory, not its output) ----
analytics/reports/*
!analytics/reports/.gitkeep
*.zip
*.parquet
*.duckdb

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/
.env/

# ---- Tooling caches ----
.pytest_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
.mypy_cache/

# ---- Terraform (no state in VCS) ----
*.tfstate
*.tfstate.*
.terraform/
.terraform.lock.hcl

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/
*.swp
